{
    "name": "acme/widget-basket",
    "type": "project",
    "description": "Acme Widget Co basket: framework-free pricing domain behind a small Laravel API.",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.17"
    },
    "require-dev": {
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": [
            "pint --test",
            "phpstan analyse"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
